{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Task",
      "Agent",
      "Write(_posts/**)",
      "Write(assets/images/**)",
      "Write(.git/daily-post-scratch/**)",
      "Edit(_posts/**)",
      "Edit(_data/topic_queue.yml)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-remote:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout master)",
      "Bash(git checkout -b daily-post/:*)",
      "Bash(git pull --ff-only origin master)",
      "Bash(git push origin master)",
      "Bash(git push -u origin daily-post/:*)",
      "Bash(git push origin daily-post/:*)",
      "Bash(git clean -fdx -- assets/images/:*)",
      "Bash(gh auth status:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh label create:*)",
      "Bash(python3 script/daily_post/dupe_check.py:*)",
      "Bash(python3 script/daily_post/make_banner.py:*)",
      "Bash(python3 script/check_frontmatter.py:*)",
      "Bash(python3 -c:*)",
      "Bash(script/daily_post/preflight.sh:*)",
      "Bash(bash -n:*)",
      "Bash(python3 -m py_compile:*)",
      "Bash(node --check:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(date:*)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Write(.claude/**)",
      "Edit(.claude/**)",
      "Write(script/**)",
      "Edit(script/**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.ssh/**)"
    ]
  }
}
